---
layout: base.njk
pageId: products
pagination:
  data: products
  size: 1
  alias: product
permalink: "/products/{{ product.slug }}.html"
eleventyComputed:
  title: "{{ product.name | safe }} — OpenVox"
  description: "{{ product.summary | safe }}"
---
<vox-breadcrumbs class="vox-p-top-md">
    <a href="/">Home</a>
    <a href="/products">Products</a>
    <span aria-current="page">{{ product.name }}</a>
</vox-breadcrumbs>

<vox-hero eyebrow="{{ product.eyebrow }}" heading="{{ product.name }}">
  <p>{{ product.summary }}</p>
  <div slot="actions">
    <vox-button href="https://docs.openvoxproject.org{{ product.docsPath }}" variant="brand" target="_blank" class="vox-p-right-lg">
      View Documentation
    </vox-button>
    <vox-cta href="/products.html">All Products</vox-cta>
  </div>
</vox-hero>

<section class="section">
  <h2 class="section-heading">Key capabilities</h2>
  <vox-grid class="card-grid" min="240px">
    {% for feature in product.features %}
    <vox-card heading="{{ feature.heading }}">{{ feature.body }}</vox-card>
    {% endfor %}
  </vox-grid>
</section>
